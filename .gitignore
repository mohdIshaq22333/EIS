# Root ignore file for EIS monorepo

# Django / Python
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/.env
backend/db.sqlite3
backend/local-readme

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env

# Editor / system files
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
